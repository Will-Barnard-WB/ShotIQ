# Supabase → Project Settings → API Keys
#
# Use the PUBLISHABLE key (sb_publishable_...). It is safe in the browser and
# row level security still applies to it. Supabase renamed these: "publishable"
# is what used to be called the anon key, and the variable name below is kept
# because that is what @supabase/ssr expects.
#
# Never put the SECRET key (sb_secret_...) in here. It bypasses row level
# security entirely, and any NEXT_PUBLIC_ variable is shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Where email confirmation links return to.
# Set this to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
